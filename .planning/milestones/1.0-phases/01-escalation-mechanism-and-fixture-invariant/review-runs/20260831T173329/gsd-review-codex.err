   1: package store
   2: 
   3: import (
   4: 	"embed"
   5: 	"errors"
   6: 	"fmt"
   7: 	"strings"
   8: 
   9: 	"github.com/golang-migrate/migrate/v4"
  10: 	"github.com/golang-migrate/migrate/v4/database/pgx/v5"
  11: 	"github.com/golang-migrate/migrate/v4/source/iofs"
  12: )
  13: 
  14: //go:embed migrations/*.sql
  15: var migrationsFS embed.FS
  16: 
  17: // RunMigrations applies all up-migrations against the DB at dbURL.
  18: // Safe to call on every startup â€” golang-migrate is idempotent.
  19: //
  20: // The pgx/v5 migrate driver registers under the "pgx5" scheme, but
  21: // pgxpool expects the standard "postgres://" URL we accept from
  22: // callers. We rewrite the scheme here so both layers are happy with
  23: // the same env variable.
  24: func RunMigrations(dbURL string) error {
  25: 	src, err := iofs.New(migrationsFS, "migrations")
  26: 	if err != nil {
  27: 		return fmt.Errorf("open embedded migrations: %w", err)
  28: 	}
  29: 
  30: 	migrateURL := dbURL
  31: 	switch {
  32: 	case strings.HasPrefix(migrateURL, "postgres://"):
  33: 		migrateURL = "pgx5://" + strings.TrimPrefix(migrateURL, "postgres://")
  34: 	case strings.HasPrefix(migrateURL, "postgresql://"):
  35: 		migrateURL = "pgx5://" + strings.TrimPrefix(migrateURL, "postgresql://")
  36: 	}
  37: 
  38: 	m, err := migrate.NewWithSourceInstance("iofs", src, migrateURL)
  39: 	if err != nil {
  40: 		return fmt.Errorf("new migrator: %w", err)
  41: 	}
  42: 
  43: 	if err := m.Up(); err != nil && !errors.Is(err, migrate.ErrNoChange) {
  44: 		return fmt.Errorf("apply migrations: %w", err)
  45: 	}
  46: 	return nil
  47: }
  48: 
  49: // keep pgx driver registered with golang-migrate
  50: var _ = pgx.Postgres{}
