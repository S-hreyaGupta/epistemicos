  81: // TestSaveAndGetRun is the round trip: everything written must come back
  82: // identical, including the nullable fields whose NULL-versus-empty distinction
  83: // carries meaning.
  84: func TestSaveAndGetRun(t *testing.T) {
  85: 	pool := testPool(t)
  86: 	s := NewPostgresSegmentationStore(pool)
  87: 	ctx := context.Background()
  88: 
  89: 	want := fixtureRun(t)
  90: 	cleanup(t, pool, want.ID)
  91: 
  92: 	if err := s.SaveRun(ctx, &want); err != nil {
  93: 		t.Fatalf("SaveRun: %v", err)
  94: 	}
  95: 
  96: 	got, err := s.GetRun(ctx, want.ID)
  97: 	if err != nil {
  98: 		t.Fatalf("GetRun: %v", err)
  99: 	}
 100: 
 101: 	if got.ExtractionRunID != want.ExtractionRunID {
 102: 		t.Errorf("extraction_run_id = %q, want %q", got.ExtractionRunID, want.ExtractionRunID)
 103: 	}
 104: 	if got.ApprovedMarkdownHash != want.ApprovedMarkdownHash {
 105: 		t.Errorf("approved_markdown_hash = %q, want %q", got.ApprovedMarkdownHash, want.ApprovedMarkdownHash)
 106: 	}
 107: 	if got.StructuralRuleVersion != "2.9" {
 108: 		t.Errorf("structural_rule_version = %q, want \"2.9\"", got.StructuralRuleVersion)
 109: 	}
 110: 	if got.Status != segment.RunCompleted {
 111: 		t.Errorf("status = %q, want %q", got.Status, segment.RunCompleted)
 112: 	}
 113: 	if got.DocumentTitleStatus != want.DocumentTitleStatus {
 114: 		t.Errorf("title status = %q, want %q", got.DocumentTitleStatus, want.DocumentTitleStatus)
 115: 	}
 116: 	if got.DocumentTitleText != want.DocumentTitleText {
 117: 		t.Errorf("title text = %q, want %q", got.DocumentTitleText, want.DocumentTitleText)
 118: 	}
 119: 	if got.DocumentTitleOrdinal != want.DocumentTitleOrdinal {
 120: 		t.Errorf("title ordinal = %d, want %d", got.DocumentTitleOrdinal, want.DocumentTitleOrdinal)
 121: 	}
 122: 
 123: 	// H5 and H6 must read back as explicit zeroes. A missing key and a zero
 124: 	// count are the same fact only until a reader treats absence as unknown,
 125: 	// and Â§10 depends on those counts being legible as deliberate exclusions.
 126: 	for level := 1; level <= 6; level++ {
 127: 		if got.HeadingCounts[level] != want.HeadingCounts[level] {
 128: 			t.Errorf("H%d count = %d, want %d", level, got.HeadingCounts[level], want.HeadingCounts[level])
 129: 		}
 130: 	}
 131: 
 132: 	if len(got.Nodes) != len(want.Nodes) {
 133: 		t.Fatalf("read back %d nodes, want %d", len(got.Nodes), len(want.Nodes))
 134: 	}
 135: 	for i := range want.Nodes {
 136: 		w, g := want.Nodes[i], got.Nodes[i]
 137: 
 138: 		if g.Ordinal != w.Ordinal {
 139: 			t.Errorf("node %d ordinal = %d, want %d", i, g.Ordinal, w.Ordinal)
 140: 		}
 141: 		if g.ParentOrdinal != w.ParentOrdinal {
 142: 			t.Errorf("node %d parent = %d, want %d", i, g.ParentOrdinal, w.ParentOrdinal)
 143: 		}
 144: 		if g.StartOffset != w.StartOffset || g.EndOffset != w.EndOffset {
 145: 			t.Errorf("node %d span = [%d,%d), want [%d,%d)", i, g.StartOffset, g.EndOffset, w.StartOffset, w.EndOffset)
 146: 		}
 147: 		if g.Kind != w.Kind {
 148: 			t.Errorf("node %d kind = %q, want %q", i, g.Kind, w.Kind)
 149: 		}
 150: 		if g.HeadingRaw != w.HeadingRaw {
 151: 			t.Errorf("node %d heading = %q, want %q", i, g.HeadingRaw, w.HeadingRaw)
 152: 		}
 153: 		if g.Classification.Role != w.Classification.Role {
 154: 			t.Errorf("node %d role = %q, want %q", i, g.Classification.Role, w.Classification.Role)
 155: 		}
 156: 		if g.Classification.Status != w.Classification.Status {
 157: 			t.Errorf("node %d status = %q, want %q", i, g.Classification.Status, w.Classification.Status)
 158: 		}
 159: 	}
 160: 
 161: 	if len(got.Tasks) != len(want.Tasks) {
 162: 		t.Fatalf("read back %d tasks, want %d", len(got.Tasks), len(want.Tasks))
 163: 	}
 164: 	for i := range want.Tasks {
 165: 		if got.Tasks[i].Reason != want.Tasks[i].Reason {
 166: 			t.Errorf("task %d reason = %q, want %q", i, got.Tasks[i].Reason, want.Tasks[i].Reason)
 167: 		}
 168: 		if got.Tasks[i].SectionOrdinal != want.Tasks[i].SectionOrdinal {
 169: 			t.Errorf("task %d section ordinal = %d, want %d", i, got.Tasks[i].SectionOrdinal, want.Tasks[i].SectionOrdinal)
 170: 		}
 171: 	}
 172: }
 173: 
 174: // TestGetRun_NotFound checks the sentinel, so callers can errors.Is rather than
 175: // string-match.
 176: func TestGetRun_NotFound(t *testing.T) {
 177: 	pool := testPool(t)
 178: 	s := NewPostgresSegmentationStore(pool)
 179: 
 180: 	_, err := s.GetRun(context.Background(), uuid.NewString())
 181: 	if err == nil {
 182: 		t.Fatal("GetRun on an unknown id returned no error")
 183: 	}
 184: 	if err != ports.ErrNotFound {
 185: 		t.Errorf("error = %v, want ports.ErrNotFound", err)
 186: 	}
 187: }
 188: 
 189: // TestSaveRun_UnresolvedNodeCannotCarryARole is the CHECK constraint under
 190: // test, not the Go code.
 191: //
 192: // Â§8's overlay model depends on an unresolved node storing no role: the
 193: // effective value prefers a human decision when one exists and falls back to
 194: // the machine determination otherwise, so a placeholder role would be
 195: // indistinguishable from a real answer. Enforcing it in the schema means a
 196: // future writer cannot forget, which a code path cannot promise.
 197: func TestSaveRun_UnresolvedNodeCannotCarryARole(t *testing.T) {
 198: 	pool := testPool(t)
 199: 	s := NewPostgresSegmentationStore(pool)
 200: 	ctx := context.Background()
 201: 
 202: 	run := fixtureRun(t)
 203: 	cleanup(t, pool, run.ID)
 204: 
 205: 	// Corrupt one node the way a careless caller might: unresolved, but
 206: 	// carrying a role anyway.
 207: 	//
 208: 	// The invalid state is constructed OUTRIGHT rather than found by searching
 209: 	// for an existing unresolved node. An earlier version did search, and under
 210: 	// rule version 2.2 it silently stopped testing anything: parent inheritance
 211: 	// resolved the only unresolved node in this fixture, the loop found nothing
 212: 	// to corrupt, and the save succeeded â€” so a test about a database constraint
 213: 	// was quietly passing on a row that was never invalid.
 214: 	run.Nodes[len(run.Nodes)-1].Classification = segment.Classification{
 215: 		Role:   segment.RoleMethodology,
 216: 		Status: segment.StatusUnresolved,
 217: 	}
 218: 
 219: 	if err := s.SaveRun(ctx, &run); err == nil {
 220: 		t.Fatal("saved an unresolved node carrying a role; the section_nodes_unresolved_is_empty constraint is not enforcing Â§8")
 221: 	}
 222: }
 223: 
 224: // TestSaveRun_IsAtomic proves a failed write leaves nothing behind.
 225: //
 226: // A partially written run is indistinguishable from a document with fewer
 227: // sections, which is exactly the silent loss Â§10 exists to prevent â€” and Â§10
 228: // runs in the domain, before the store, so it cannot catch this.
 229: func TestSaveRun_IsAtomic(t *testing.T) {
 230: 	pool := testPool(t)
 231: 	s := NewPostgresSegmentationStore(pool)
 232: 	ctx := context.Background()
 233: 
 234: 	run := fixtureRun(t)
 235: 	cleanup(t, pool, run.ID)
 236: 
 237: 	// A heading level outside 1-4 violates section_nodes_level_valid, so the
 238: 	// insert fails partway through the node loop.
 239: 	run.Nodes[len(run.Nodes)-1].HeadingLevel = 7
 240: 
 241: 	if err := s.SaveRun(ctx, &run); err == nil {
 242: 		t.Fatal("SaveRun accepted an invalid heading level")
 243: 	}
 244: 
 245: 	var count int
 246: 	if err := pool.QueryRow(ctx,
 247: 		`SELECT count(*) FROM segmentation_runs WHERE segmentation_run_id = $1`, run.ID,
 248: 	).Scan(&count); err != nil {
 249: 		t.Fatalf("count runs: %v", err)
 250: 	}
 251: 	if count != 0 {
 252: 		t.Errorf("a failed SaveRun left %d run rows behind; the write is not atomic", count)
 253: 	}
 254: 
 255: 	if err := pool.QueryRow(ctx,
 256: 		`SELECT count(*) FROM section_nodes WHERE segmentation_run_id = $1`, run.ID,
 257: 	).Scan(&count); err != nil {
 258: 		t.Fatalf("count nodes: %v", err)
 259: 	}
 260: 	if count != 0 {
 261: 		t.Errorf("a failed SaveRun left %d node rows behind", count)
 262: 	}
 263: }
 264: 
 265: // TestSaveRun_FixtureRoundTripsAllOffsets persists the real reference document
 266: // and reads back all 22 spans.
 267: //
 268: // The domain tests already prove Build produces the right offsets. This proves
 269: // they survive a round trip through Postgres â€” that nothing is truncated by a
 270: // column type, and that parent links reconstruct from ids back into ordinals.
 271: func TestSaveRun_FixtureRoundTripsAllOffsets(t *testing.T) {
 272: 	pool := testPool(t)
 273: 	s := NewPostgresSegmentationStore(pool)
 274: 	ctx := context.Background()
 275: 
 276: 	md, err := os.ReadFile("../../../core/domain/segment/testdata/demo.md")
 277: 	if err != nil {
 278: 		t.Skipf("fixture not readable from here: %v", err)
 279: 	}
 280: 
 281: 	doc, err := segment.Build(md)
 282: 	if err != nil {
 283: 		t.Fatalf("Build: %v", err)
 284: 	}
 285: 
 286: 	run := segment.NewRun(doc, "fixture-paper", "a5f1feb02d617bcc0e2314f8ad6d0df1c7bedd9631f22493c87c57b09917242e")
 287: 	run.ID = uuid.NewString()
 288: 	run.NodeIDs = make([]string, len(run.Nodes))
 289: 	for i := range run.Nodes {
 290: 		run.NodeIDs[i] = uuid.NewString()
 291: 	}
 292: 	run.TaskIDs = make([]string, len(run.Tasks))
 293: 	for i := range run.Tasks {
 294: 		run.TaskIDs[i] = uuid.NewString()
 295: 	}
 296: 	cleanup(t, pool, run.ID)
 297: 
 298: 	if err := s.SaveRun(ctx, &run); err != nil {
 299: 		t.Fatalf("SaveRun: %v", err)
 300: 	}
 301: 
 302: 	got, err := s.GetRun(ctx, run.ID)
 303: 	if err != nil {
 304: 		t.Fatalf("GetRun: %v", err)
 305: 	}
 306: 
 307: 	if len(got.Nodes) != 22 {
 308: 		t.Fatalf("read back %d nodes, want 22", len(got.Nodes))
 309: 	}
 310: 	// NONE under rule version 2.7. Six at 2.1, five at 2.2 once "4.2 Structural
 311: 	// model" inherited results, and zero at 2.7 once nested-occurrence
 312: 	// suppression resolved "2 Theoretical background and hypotheses derivation"
 313: 	// and its four subsections inherited theory.
 314: 	//
 315: 	// The count is asserted rather than derived, deliberately. This is a
 316: 	// PERSISTENCE test: a run with no tasks must still round-trip, and a store
 317: 	// that silently dropped every task would pass any assertion computed from
 318: 	// the run it was just handed.
 319: 	if len(got.Tasks) != 0 {
 320: 		t.Errorf("read back %d tasks, want 0", len(got.Tasks))
 321: 	}
 322: 
 323: 	for i := range run.Nodes {
 324: 		if got.Nodes[i].StartOffset != run.Nodes[i].StartOffset ||
 325: 			got.Nodes[i].EndOffset != run.Nodes[i].EndOffset {
 326: 			t.Errorf("node %d span = [%d,%d), want [%d,%d)",
 327: 				i, got.Nodes[i].StartOffset, got.Nodes[i].EndOffset,
 328: 				run.Nodes[i].StartOffset, run.Nodes[i].EndOffset)
 329: 		}
 330: 		if got.Nodes[i].ParentOrdinal != run.Nodes[i].ParentOrdinal {
 331: 			t.Errorf("node %d parent = %d, want %d", i, got.Nodes[i].ParentOrdinal, run.Nodes[i].ParentOrdinal)
 332: 		}
 333: 	}
 334: }
### internal/adapters/secondary/approved/papers_test.go
   1: package approved
   2: 
   3: import (
   4: 	"context"
   5: 	"crypto/sha256"
   6: 	"encoding/hex"
   7: 	"errors"
   8: 	"os"
   9: 	"strings"
  10: 	"testing"
  11: 	"time"
  12: 
  13: 	"github.com/google/uuid"
  14: 	"github.com/jackc/pgx/v5/pgxpool"
  15: 
  16: 	"github.com/EpistemicOS/epistemicos/internal/core/ports"
  17: )
  18: 
  19: // testPool connects to EPISTEMIC_OS_DB_URL, or skips.
  20: //
  21: // Skipping rather than failing keeps a developer without Docker from seeing a
  22: // red build for a reason unrelated to their change. The skip message names the
  23: // variable so a silent skip in CI is not mistaken for a pass.
  24: func testPool(t *testing.T) *pgxpool.Pool {
  25: 	t.Helper()
  26: 
  27: 	url := os.Getenv("EPISTEMIC_OS_DB_URL")
  28: 	if url == "" {
  29: 		t.Skip("EPISTEMIC_OS_DB_URL is not set; start postgres and export it to run these tests")
  30: 	}
  31: 
  32: 	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
  33: 	defer cancel()
  34: 
  35: 	pool, err := pgxpool.New(ctx, url)
  36: 	if err != nil {
  37: 		t.Fatalf("connect: %v", err)
  38: 	}
  39: 	if err := pool.Ping(ctx); err != nil {
  40: 		pool.Close()
  41: 		t.Skipf("cannot reach postgres: %v", err)
  42: 	}
  43: 
  44: 	t.Cleanup(pool.Close)
  45: 	return pool
  46: }
  47: 
  48: // insertPaper writes a papers row directly, so a test can construct states the
  49: // ingest service would never produce â€” including the corrupt one AC-13 is
  50: // about.
  51: func insertPaper(t *testing.T, pool *pgxpool.Pool, status, markdown, storedHash string) string {
  52: 	t.Helper()
  53: 
  54: 	id := uuid.NewString()
  55: 	_, err := pool.Exec(context.Background(), `
  56: 		INSERT INTO papers (id, url, hash, title, status, error, markdown, markdown_hash)
  57: 		VALUES ($1, '', $2, '', $3, '', $4, $5)`,
  58: 		id, uuid.NewString(), status, markdown, storedHash)
  59: 	if err != nil {
  60: 		t.Fatalf("insert paper: %v", err)
  61: 	}
  62: 
  63: 	t.Cleanup(func() {
  64: 		_, _ = pool.Exec(context.Background(), `DELETE FROM papers WHERE id = $1`, id)
  65: 	})
  66: 
  67: 	return id
  68: }
  69: 
  70: func hashOf(s string) string {
  71: 	sum := sha256.Sum256([]byte(s))
  72: 	return hex.EncodeToString(sum[:])
  73: }
  74: 
  75: // TestAC13_HashMismatchIsRefused is acceptance criterion AC-13.
  76: //
  77: // It could not be written in internal/core/domain/segment, which sees only text
  78: // going in and sections coming out. The check lives here, so the test does too.
  79: //
  80: // # Why this matters more than it looks
  81: //
  82: // papers.markdown and papers.markdown_hash are written in a single statement, so
  83: // they cannot normally diverge. "Cannot normally" is not a property Step 3 can
  84: // rest on: every byte offset it produces indexes into this exact text. Markdown
  85: // that does not match its recorded hash yields spans that slice the WRONG BYTES
  86: // â€” and the result is not an error, it is a plausible-looking quotation of a
  87: // paper that says something the authors did not write.
  88: //
  89: // That is why the adapter recomputes rather than trusting. The cost is one
  90: // SHA-256 over text just read from a database; the failure it prevents is a
  91: // confident, wrong quote three phases downstream.
  92: func TestAC13_HashMismatchIsRefused(t *testing.T) {
  93: 	pool := testPool(t)
  94: 	src := NewPapersSource(pool)
  95: 
  96: 	const markdown = "# A Study Of Things\n\nBody text.\n"
  97: 
  98: 	// The corruption: a row whose stored hash belongs to different text. In
  99: 	// production this could come from a partial write, a manual UPDATE, or a
 100: 	// restored backup that mixed generations.
 101: 	id := insertPaper(t, pool, "ready", markdown, hashOf("completely different text"))
 102: 
 103: 	_, _, err := src.Get(context.Background(), id)
 104: 	if err == nil {
 105: 		t.Fatal("the adapter returned markdown whose hash does not match it; every offset derived from that text would be unverifiable")
 106: 	}
 107: 	if !strings.Contains(err.Error(), "hashes to") {
 108: 		t.Errorf("error = %q, want it to name the hash mismatch", err)
 109: 	}
 110: }
 111: 
 112: // TestAC13_MatchingHashIsAccepted is the other half. A check that refuses
 113: // everything satisfies the test above and is useless.
 114: func TestAC13_MatchingHashIsAccepted(t *testing.T) {
 115: 	pool := testPool(t)
 116: 	src := NewPapersSource(pool)
 117: 
 118: 	const markdown = "# A Study Of Things\n\nBody text.\n"
 119: 	want := hashOf(markdown)
 120: 
 121: 	id := insertPaper(t, pool, "ready", markdown, want)
 122: 
 123: 	gotMarkdown, gotHash, err := src.Get(context.Background(), id)
 124: 	if err != nil {
 125: 		t.Fatalf("Get: %v", err)
 126: 	}
 127: 	if gotMarkdown != markdown {
 128: 		t.Errorf("markdown = %q, want %q", gotMarkdown, markdown)
 129: 	}
 130: 	if gotHash != want {
 131: 		t.Errorf("hash = %q, want %q", gotHash, want)
 132: 	}
 133: }
 134: 
 135: // TestAC13_UnconvertedPaperIsRefused covers the Â§2 precondition as this
 136: // repository implements it.
 137: //
 138: // The specification requires an ExtractionRun with status = Approved. There is
 139: // no such entity here, so 'ready' stands in for it â€” and 'ready' means only
 140: // that Mathpix finished, not that a human approved anything. Whatever the word
 141: // means, a paper that has NOT reached it must not be segmented, and this is
 142: // what makes that a check rather than an assumption.
 143: func TestAC13_UnconvertedPaperIsRefused(t *testing.T) {
 144: 	pool := testPool(t)
 145: 	src := NewPapersSource(pool)
 146: 
 147: 	const markdown = "# A Study Of Things\n\nBody text.\n"
 148: 
 149: 	for _, status := range []string{"pending", "downloading", "processing", "failed"} {
 150: 		t.Run(status, func(t *testing.T) {
 151: 			id := insertPaper(t, pool, status, markdown, hashOf(markdown))
 152: 
 153: 			if _, _, err := src.Get(context.Background(), id); err == nil {
 154: 				t.Errorf("a paper with status %q was accepted for segmentation", status)
 155: 			}
 156: 		})
 157: 	}
 158: }
 159: 
 160: // TestAC13_EmptyMarkdownIsRefused guards a state that would otherwise segment
 161: // "successfully" into nothing.
 162: //
 163: // A ready paper with no markdown produces a run with one whole-document node
 164: // covering zero bytes. That is a completed run over an empty document â€” which
 165: // looks identical to a paper that genuinely had no headings, and is exactly the
 166: // kind of quiet nonsense Â§10 exists to prevent.
 167: func TestAC13_EmptyMarkdownIsRefused(t *testing.T) {
 168: 	pool := testPool(t)
 169: 	src := NewPapersSource(pool)
 170: 
 171: 	id := insertPaper(t, pool, "ready", "", "")
 172: 
 173: 	if _, _, err := src.Get(context.Background(), id); err == nil {
 174: 		t.Fatal("a ready paper with no markdown was accepted")
 175: 	}
 176: }
 177: 
 178: // TestGet_NotFound checks the sentinel so callers can errors.Is rather than
 179: // string-match.
 180: func TestGet_NotFound(t *testing.T) {
 181: 	pool := testPool(t)
 182: 	src := NewPapersSource(pool)
 183: 
 184: 	_, _, err := src.Get(context.Background(), uuid.NewString())
 185: 	if !errors.Is(err, ports.ErrNotFound) {
 186: 		t.Errorf("error = %v, want ports.ErrNotFound", err)
 187: 	}
 188: }
### internal/core/domain/segment/fixture_test.go
   1: package segment
   2: 
   3: import (
   4: 	"crypto/sha256"
   5: 	"encoding/hex"
   6: 	"encoding/json"
   7: 	"os"
   8: 	"path/filepath"
   9: 	"testing"
  10: )
  11: 
  12: // fixtureSHA256 is the SHA-256 of testdata/demo.md, the reference fixture named
  13: // in specification v2.1 Â§15.
  14: //
  15: // This constant is the reason .gitattributes marks the fixture `-text`. Every
  16: // offset in expected.json is a byte offset into these exact bytes, so any
  17: // transformation of the file â€” most plausibly core.autocrlf=true rewriting LF
  18: // as CRLF on a Windows checkout â€” invalidates all 22 spans at once. Under CRLF
  19: // each span would shift by one byte per preceding line, which produces a
  20: // failure that reads as a segmentation bug and sends someone hunting through
  21: // the parser. Asserting the hash first converts that into one unambiguous
  22: // error naming the fixture.
  23: const fixtureSHA256 = "a5f1feb02d617bcc0e2314f8ad6d0df1c7bedd9631f22493c87c57b09917242e"
  24: 
  25: // fixtureBytes is the fixture's length in bytes, asserted alongside the hash
  26: // purely so a truncation reports its own size rather than an opaque hash
  27: // mismatch.
  28: const fixtureBytes = 81492
  29: 
  30: // expectedNode is the subset of expected.json this phase can check. The
  31: // remaining fields â€” roles, content classes, classification status â€” are
  32: // produced by phases 2 through 4 and are asserted there.
  33: type expectedNode struct {
  34: 	SectionID       string  `json:"section_id"`
  35: 	ParentSectionID *string `json:"parent_section_id"`
  36: 	NodeKind        string  `json:"node_kind"`
  37: 	HeadingRaw      string  `json:"heading_raw"`
  38: 	HeadingLevel    int     `json:"heading_level"`
  39: 	StartOffset     int     `json:"start_offset"`
  40: 	EndOffset       int     `json:"end_offset"`
  41: 
  42: 	// The Â§6 and Â§7 pipeline outputs. The three nullable fields are pointers
  43: 	// because null and "" are different states here: a null semantic_heading
  44: 	// means a bare structural container with nothing to classify, while an
  45: 	// empty string would mean a heading that normalized away to nothing.
  46: 	HeadingNormalized   string  `json:"heading_normalized"`
  47: 	SemanticHeading     *string `json:"semantic_heading"`
  48: 	StructuralContainer *string `json:"structural_container"`
  49: 	AppendixLabel       *string `json:"appendix_label"`
  50: 
  51: 	// The Â§6 classification outputs. PrimaryRole and ClassificationMethod are
  52: 	// null on every unresolved node, which is the point: Â§8's overlay model
  53: 	// requires the stored determination to record having no answer rather than
  54: 	// carrying a placeholder a later reader would mistake for a decision.
  55: 	//
  56: 	// ContentClass is null on unresolved nodes too, since it is derived from
  57: 	// the role â€” but NOT on the document title, which has a null role and an
  58: 	// administrative class. The title is not unclassified; it is classified as
  59: 	// something that is not a section role.
  60: 	PrimaryRole          *string `json:"primary_role"`
  61: 	ContentClass         *string `json:"content_class"`
  62: 	ClassificationStatus string  `json:"classification_status"`
  63: 	ClassificationMethod *string `json:"classification_method"`
  64: }
  65: 
  66: // expectedTask mirrors one entry of expected.json's ReviewTasks.
  67: type expectedTask struct {
  68: 	ReviewTaskID    string   `json:"review_task_id"`
  69: 	SectionID       string   `json:"section_id"`
  70: 	ReviewReason    string   `json:"review_reason"`
  71: 	CandidateRoles  []string `json:"candidate_roles"`
  72: 	MatchedKeywords []string `json:"matched_keywords"`
  73: 	Status          string   `json:"status"`
  74: }
  75: 
  76: type expectedOutput struct {
  77: 	SectionNodes []expectedNode `json:"SectionNodes"`
  78: 	ReviewTasks  []expectedTask `json:"ReviewTasks"`
  79: }
  80: 
  81: // loadFixture returns the fixture's bytes, having first proved they are the
  82: // bytes expected.json was computed against. Every test that consumes offsets
  83: // goes through here rather than calling os.ReadFile directly.
  84: func loadFixture(t *testing.T) []byte {
  85: 	t.Helper()
  86: 
  87: 	src, err := os.ReadFile(filepath.Join("testdata", "demo.md"))
  88: 	if err != nil {
  89: 		t.Fatalf("read fixture: %v", err)
  90: 	}
  91: 
  92: 	if len(src) != fixtureBytes {
  93: 		t.Fatalf("fixture is %d bytes, want %d â€” the file has been altered, most likely by line-ending conversion; check that .gitattributes still marks it -text", len(src), fixtureBytes)
  94: 	}
  95: 
  96: 	sum := sha256.Sum256(src)
  97: 	if got := hex.EncodeToString(sum[:]); got != fixtureSHA256 {
  98: 		t.Fatalf("fixture SHA-256 is %s, want %s â€” the length is right but the content is not, so every byte offset in expected.json is invalid against it", got, fixtureSHA256)
  99: 	}
 100: 
 101: 	return src
 102: }
 103: 
 104: // loadExpected returns the parsed expected output.
 105: func loadExpected(t *testing.T) expectedOutput {
 106: 	t.Helper()
 107: 
 108: 	raw, err := os.ReadFile(filepath.Join("testdata", "expected.json"))
 109: 	if err != nil {
 110: 		t.Fatalf("read expected.json: %v", err)
 111: 	}
 112: 
 113: 	var out expectedOutput
 114: 	if err := json.Unmarshal(raw, &out); err != nil {
 115: 		t.Fatalf("parse expected.json: %v", err)
 116: 	}
 117: 	if len(out.SectionNodes) == 0 {
 118: 		t.Fatal("expected.json contains no SectionNodes")
 119: 	}
 120: 
 121: 	return out
 122: }
 123: 
 124: // TestFixtureIntegrity is deliberately separate from the detection tests below.
 125: // If the fixture is wrong, every other assertion in this package is meaningless,
 126: // and a single failure naming the file is more useful than twenty failures
 127: // naming offsets.
 128: func TestFixtureIntegrity(t *testing.T) {
 129: 	src := loadFixture(t)
 130: 
 131: 	// The fixture is stored with LF. A stray CR would mean the -text pin was
 132: 	// removed or the file was regenerated on Windows, and while the hash check
 133: 	// above already catches that, this names the cause directly.
 134: 	for i, b := range src {
 135: 		if b == '\r' {
 136: 			t.Fatalf("fixture contains a carriage return at byte %d; it must be stored with LF line endings only", i)
 137: 		}
 138: 	}
 139: }
 140: 
 141: // TestDetectHeadings_Fixture is the phase 1 done-condition from Â§15: the
 142: // detector must find exactly the 22 headings the specification names, at the
 143: // levels it names, in document order.
 144: //
 145: // The level distribution is asserted as a whole rather than as a total, because
 146: // a total alone passes if an H3 is misread as an H2. The distribution is what
 147: // Â§15 actually claims: 1 H1, 8 H2, 12 H3, 1 H4, and no H5 or H6 anywhere.
 148: func TestDetectHeadings_Fixture(t *testing.T) {
 149: 	src := loadFixture(t)
 150: 	exp := loadExpected(t)
 151: 
 152: 	got := detectHeadings(src)
 153: 
 154: 	if len(got) != len(exp.SectionNodes) {
 155: 		t.Fatalf("detected %d headings, want %d", len(got), len(exp.SectionNodes))
 156: 	}
 157: 
 158: 	wantCounts := map[int]int{1: 1, 2: 8, 3: 12, 4: 1, 5: 0, 6: 0}
 159: 	gotCounts := map[int]int{}
 160: 	for _, h := range got {
 161: 		gotCounts[h.Level]++
 162: 	}
 163: 	for level := 1; level <= 6; level++ {
 164: 		if gotCounts[level] != wantCounts[level] {
 165: 			t.Errorf("H%d count is %d, want %d", level, gotCounts[level], wantCounts[level])
 166: 		}
 167: 	}
 168: }
 169: 
 170: // TestDetectHeadings_MatchesExpectedText checks each detected heading against
 171: // the heading_raw expected.json records for the node at the same position.
 172: //
 173: // This is the assertion that makes the phase meaningful. Counting headings
 174: // proves the parser found the right NUMBER of things; comparing the text proves
 175: // it found the right things, and that TextStart/TextStop delimit the heading
 176: // text with markers and any closing '###' already removed.
 177: func TestDetectHeadings_MatchesExpectedText(t *testing.T) {
 178: 	src := loadFixture(t)
 179: 	exp := loadExpected(t)
 180: 
 181: 	got := detectHeadings(src)
 182: 	if len(got) != len(exp.SectionNodes) {
 183: 		t.Fatalf("detected %d headings, want %d; run TestDetectHeadings_Fixture first", len(got), len(exp.SectionNodes))
 184: 	}
 185: 
 186: 	for i, want := range exp.SectionNodes {
 187: 		h := got[i]
 188: 
 189: 		if h.Level != want.HeadingLevel {
 190: 			t.Errorf("heading %d (%s): level %d, want %d", i, want.SectionID, h.Level, want.HeadingLevel)
 191: 		}
 192: 
 193: 		if text := string(src[h.TextStart:h.TextStop]); text != want.HeadingRaw {
 194: 			t.Errorf("heading %d (%s): text %q, want %q", i, want.SectionID, text, want.HeadingRaw)
 195: 		}
 196: 	}
 197: }
 198: 
 199: // TestDetectHeadings_OffsetsAreWellFormed asserts the two structural properties
 200: // every downstream phase relies on, independently of what any heading says.
 201: //
 202: // ByteStart must address a '#'. goldmark documents Pos() as the first non-space
 203: // byte of the block's opening line, and for an ATX heading that byte is the '#'
 204: // â€” but it is documented behaviour of a dependency, not a guarantee of this
 205: // package, so it is verified against the source bytes rather than assumed. If
 206: // goldmark ever regresses Pos(), this fails here rather than producing spans
 207: // that are silently off by the indent.
 208: //
 209: // Headings must also be strictly increasing. detectHeadings performs no sort
 210: // and relies on ast.Walk visiting in document order; this is what makes that
 211: // reliance safe to state.
 212: func TestDetectHeadings_OffsetsAreWellFormed(t *testing.T) {
 213: 	src := loadFixture(t)
 214: 	got := detectHeadings(src)
 215: 
 216: 	prev := -1
 217: 	for i, h := range got {
 218: 		if h.ByteStart < 0 || h.ByteStart >= len(src) {
 219: 			t.Fatalf("heading %d: ByteStart %d is outside the document [0,%d)", i, h.ByteStart, len(src))
 220: 		}
 221: 		if src[h.ByteStart] != '#' {
 222: 			t.Errorf("heading %d: ByteStart %d addresses %q, want '#'", i, h.ByteStart, src[h.ByteStart])
 223: 		}
 224: 		if h.ByteStart <= prev {
 225: 			t.Errorf("heading %d: ByteStart %d does not follow the previous heading at %d", i, h.ByteStart, prev)
 226: 		}
 227: 		prev = h.ByteStart
 228: 
 229: 		if h.TextStart > h.TextStop {
 230: 			t.Errorf("heading %d: inverted text range [%d,%d)", i, h.TextStart, h.TextStop)
 231: 		}
 232: 		if h.TextStart < h.ByteStart {
 233: 			t.Errorf("heading %d: TextStart %d precedes ByteStart %d", i, h.TextStart, h.ByteStart)
 234: 		}
 235: 		if h.TextStop > len(src) {
 236: 			t.Errorf("heading %d: TextStop %d exceeds the document length %d", i, h.TextStop, len(src))
 237: 		}
 238: 	}
 239: }
### internal/core/domain/segment/acceptance_test.go
   1: package segment
   2: 
   3: import (
   4: 	"strings"
   5: 	"testing"
   6: )
   7: 
   8: // Acceptance criteria AC-01 through AC-14 from specification v2.1 Â§14.
   9: //
  10: // Each is named for its criterion so the done-condition can be read off a test
  11: // run rather than reasoned about. Several overlap with tests elsewhere in this
  12: // package, and the duplication is deliberate: those tests are named for the
  13: // behaviour they guard and would be renamed or split as the code moves, whereas
  14: // these are named for a contract that does not.
  15: //
  16: // AC-11, AC-12 and AC-13 are not here. They concern the pointer chain, Step 4's
  17: // consumption and the hash gate, which live outside this package. See the notes
  18: // at the bottom of the file, and docs/DEFERRED_CRITERIA.md for the version
  19: // addressed to whoever builds Step 2 and Step 4.
  20: 
  21: // AC-01 â€” a standard paper produces a title node plus one node per detected
  22: // H2-H4, with conventional headings resolved by rule and content_class
  23: // populated from the table.
  24: func TestAC01_StandardPaper(t *testing.T) {
  25: 	md := loadFixture(t)
  26: 	exp := loadExpected(t)
  27: 
  28: 	doc, err := Build(md)
  29: 	if err != nil {
  30: 		t.Fatalf("Build: %v", err)
  31: 	}
  32: 
  33: 	if len(doc.Nodes) != len(exp.SectionNodes) {
  34: 		t.Fatalf("built %d nodes, want %d", len(doc.Nodes), len(exp.SectionNodes))
  35: 	}
  36: 
  37: 	titles := 0
  38: 	for _, n := range doc.Nodes {
  39: 		if n.Kind == KindDocumentTitle {
  40: 			titles++
  41: 		}
  42: 		if n.HeadingLevel < 1 || n.HeadingLevel > 4 {
  43: 			t.Errorf("node %d has level %d, outside the structural contract", n.Ordinal, n.HeadingLevel)
  44: 		}
  45: 		// Every resolved node carries a class; every unresolved one carries
  46: 		// neither role nor class.
  47: 		if n.Classification.Status == StatusResolved && n.Classification.ContentClass == "" {
  48: 			t.Errorf("node %d (%q) resolved without a content class", n.Ordinal, n.HeadingRaw)
  49: 		}
  50: 		if n.Classification.Status == StatusUnresolved && n.Classification.Role != "" {
  51: 			t.Errorf("node %d (%q) is unresolved but carries role %q", n.Ordinal, n.HeadingRaw, n.Classification.Role)
  52: 		}
  53: 	}
  54: 	if titles != 1 {
  55: 		t.Errorf("%d title nodes, want exactly 1", titles)
  56: 	}
  57: }
  58: 
  59: // AC-02 â€” #### Abstract becomes its own node with primary_role = abstract, by
  60: // ordinary exact match. No promotion, no rescue, no special mechanism.
  61: func TestAC02_AbstractResolvesByOrdinaryMatch(t *testing.T) {
  62: 	md := loadFixture(t)
  63: 
  64: 	doc, err := Build(md)
  65: 	if err != nil {
  66: 		t.Fatalf("Build: %v", err)
  67: 	}
  68: 
  69: 	found := false
  70: 	for _, n := range doc.Nodes {
  71: 		if n.HeadingRaw != "Abstract" {
  72: 			continue
  73: 		}
  74: 		found = true
  75: 
  76: 		if n.HeadingLevel != 4 {
  77: 			t.Errorf("Abstract level = %d, want 4", n.HeadingLevel)
  78: 		}
  79: 		if n.Classification.Role != RoleAbstract {
  80: 			t.Errorf("Abstract role = %q, want %q", n.Classification.Role, RoleAbstract)
  81: 		}
  82: 		if n.Classification.Method != MethodRule {
  83: 			t.Errorf("Abstract method = %q, want %q â€” it must resolve by ordinary keyword match, not by a special case", n.Classification.Method, MethodRule)
  84: 		}
  85: 	}
  86: 	if !found {
  87: 		t.Fatal("no Abstract node in the fixture")
  88: 	}
  89: }
  90: 
  91: // AC-03 â€” a heading hitting two distinct roles is unresolved, with both
  92: // candidates recorded and NO tie-break applied.
  93: //
  94: // The example CHANGED at 2.7. It used to be "theoretical background and
  95: // hypotheses derivation", which was never a genuine tie: its `background` hit
  96: // lay inside its `theoretical background` hit, so one span was being counted as
  97: // two opinions. That heading now resolves to theory, and nested_test.go covers
  98: // it. "Background and literature review" is a real tie â€” neither keyword
  99: // contains the other â€” which is what this criterion is actually about.
 100: func TestAC03_MultiRoleMatchIsNotTieBroken(t *testing.T) {
 101: 	got := Classify("background and literature review")
 102: 
 103: 	if got.Status != StatusUnresolved {
 104: 		t.Fatalf("status = %q, want %q â€” a tie must not be resolved by preference order", got.Status, StatusUnresolved)
 105: 	}
 106: 	if got.Role != "" {
 107: 		t.Errorf("role = %q, want empty", got.Role)
 108: 	}
 109: 	for _, m := range got.Matches {
 110: 		if m.SuppressedBy != "" {
 111: 			t.Errorf("%q suppressed by %q; neither keyword contains the other, so this must be a real tie", m.Keyword, m.SuppressedBy)
 112: 		}
 113: 	}
 114: 
 115: 	want := []Role{RoleIntroduction, RoleLiteratureReview}
 116: 	if len(got.CandidateRoles) != len(want) {
 117: 		t.Fatalf("candidates = %v, want %v", got.CandidateRoles, want)
 118: 	}
 119: 	for i := range want {
 120: 		if got.CandidateRoles[i] != want[i] {
 121: 			t.Errorf("candidate %d = %q, want %q", i, got.CandidateRoles[i], want[i])
 122: 		}
 123: 	}
 124: }
 125: 
 126: // AC-04 â€” several keywords from the SAME role resolve cleanly, with no review
 127: // task. This is the distinct-role count, and it is the rule most easily got
 128: // wrong by counting hits instead.
 129: func TestAC04_SameRoleMultiKeywordResolves(t *testing.T) {
 130: 	got := Classify("prior research and extant literature")
 131: 
 132: 	if got.Status != StatusResolved {
 133: 		t.Fatalf("status = %q, want %q â€” two keywords from one role is one role", got.Status, StatusResolved)
 134: 	}
 135: 	if got.Role != RoleLiteratureReview {
 136: 		t.Errorf("role = %q, want %q", got.Role, RoleLiteratureReview)
 137: 	}
 138: 	if got.Method != MethodRule {
 139: 		t.Errorf("method = %q, want %q", got.Method, MethodRule)
 140: 	}
 141: 	if len(got.MatchedKeywords) < 2 {
 142: 		t.Errorf("matched keywords = %v, want at least two, or this test proves nothing", got.MatchedKeywords)
 143: 	}
 144: }
 145: 
 146: // AC-05 â€” all four identifier forms are stripped and the heading resolves
 147: // normally afterwards.
 148: func TestAC05_IdentifiersAreStripped(t *testing.T) {
 149: 	cases := []struct {
 150: 		heading string
 151: 		want    Role
 152: 	}{
 153: 		{"IV. Results", RoleResults},
 154: 		{"A. Methods", RoleMethodology},
 155: 		{"2.1 Methods", RoleMethodology},
 156: 		{"Section 4: Results", RoleResults},
 157: 	}
 158: 
 159: 	for _, c := range cases {
 160: 		t.Run(c.heading, func(t *testing.T) {
 161: 			_, _, semantic := ParseContainer(StripIdentifiers(Normalize(c.heading)))
 162: 			got := Classify(semantic)
 163: 
 164: 			if got.Status != StatusResolved {
 165: 				t.Fatalf("status = %q, want %q (semantic heading was %q)", got.Status, StatusResolved, semantic)
 166: 			}
 167: 			if got.Role != c.want {
 168: 				t.Errorf("role = %q, want %q", got.Role, c.want)
 169: 			}
 170: 		})
 171: 	}
 172: }
 173: 
 174: // AC-06 (2.5) â€” appendix containers. EVERY appendix resolves to Unknown
 175: // structurally, whatever its suffix says, and raises no task. The suffix is
 176: // still parsed and retained; it is simply not classified.
 177: func TestAC06_AppendixContainers(t *testing.T) {
 178: 	t.Run("labelled with suffix is still Unknown", func(t *testing.T) {
 179: 		md := []byte("## Appendix B: Robustness checks\n\nBody.\n")
 180: 
 181: 		doc, err := Build(md)
 182: 		if err != nil {
 183: 			t.Fatalf("Build: %v", err)
 184: 		}
 185: 		n := doc.Nodes[0]
 186: 
 187: 		if n.Container != ContainerAppendix {
 188: 			t.Errorf("container = %q, want %q", n.Container, ContainerAppendix)
 189: 		}
 190: 		if n.AppendixLabel != "B" {
 191: 			t.Errorf("label = %q, want \"B\"", n.AppendixLabel)
 192: 		}
 193: 
 194: 		// The suffix "robustness checks" is a results keyword and must NOT be
 195: 		// read as one. An appendix title says what the appendix is about, not
 196: 		// what work it does, and which part of the paper it supports is not
 197: 		// recoverable from the title.
 198: 		if n.Classification.Role != RoleUnknown {
 199: 			t.Errorf("role = %q, want %q â€” an appendix suffix is not classified", n.Classification.Role, RoleUnknown)
 200: 		}
 201: 		if n.Classification.ContentClass != ClassAnalytical {
 202: 			t.Errorf("class = %q, want %q", n.Classification.ContentClass, ClassAnalytical)
 203: 		}
 204: 		if n.Classification.Method != MethodStructural {
 205: 			t.Errorf("method = %q, want %q", n.Classification.Method, MethodStructural)
 206: 		}
 207: 
 208: 		// Retained, not discarded. This is what makes the change a decision
 209: 		// about roles rather than about what is kept.
 210: 		if n.SemanticHeading != "robustness checks" {
 211: 			t.Errorf("semantic heading = %q, want it retained", n.SemanticHeading)
 212: 		}
 213: 	})
 214: 
 215: 	t.Run("bare container", func(t *testing.T) {
 216: 		container, label, semantic := ParseContainer(StripIdentifiers(Normalize("Appendix B")))
 217: 
 218: 		if container != ContainerAppendix || label != "B" || semantic != "" {
 219: 			t.Errorf("parse = (%q, %q, %q), want (appendix, B, empty)", container, label, semantic)
 220: 		}
 221: 
 222: 		got := Classify(semantic)
 223: 		if got.Role != RoleUnknown {
 224: 			t.Errorf("role = %q, want %q", got.Role, RoleUnknown)
 225: 		}
 226: 		if got.ContentClass != ClassAnalytical {
 227: 			t.Errorf("content class = %q, want %q", got.ContentClass, ClassAnalytical)
 228: 		}
 229: 		if got.Status != StatusResolved {
 230: 			t.Errorf("status = %q, want %q â€” a bare container is a complete answer", got.Status, StatusResolved)
 231: 		}
 232: 		if got.Method != MethodStructural {
 233: 			t.Errorf("method = %q, want %q", got.Method, MethodStructural)
 234: 		}
 235: 	})
 236: 
 237: 	t.Run("child classifies independently", func(t *testing.T) {
 238: 		md := []byte("## Appendix B\n\nBody.\n\n### Robustness checks\n\nChild body.\n")
 239: 
 240: 		doc, err := Build(md)
 241: 		if err != nil {
 242: 			t.Fatalf("Build: %v", err)
 243: 		}
 244: 
 245: 		if doc.Nodes[1].Classification.Role != RoleResults {
 246: 			t.Errorf("child role = %q, want %q â€” classification is parent-independent", doc.Nodes[1].Classification.Role, RoleResults)
 247: 		}
 248: 
 249: 		// Neither the container nor its child may raise a task: the container
 250: 		// is a complete structural answer, and the child resolved by rule.
 251: 		//
 252: 		// Counted per node rather than as a total. This snippet has no H1, so
 253: 		// Â§4 correctly raises a title_ambiguity task, and a total would fold
 254: 		// that unrelated rule into a criterion about containers â€” which is
 255: 		// what an earlier version of this test did, and it failed for the
 256: 		// right reason.
 257: 		run := NewRun(doc, "ac06", "hash")
 258: 		for _, task := range run.Tasks {
 259: 			if task.SectionOrdinal == 0 {
 260: 				t.Errorf("the bare container raised a %s task; it resolves structurally and has nothing to adjudicate", task.Reason)
 261: 			}
 262: 			if task.SectionOrdinal == 1 {
 263: 				t.Errorf("the child raised a %s task despite resolving to %s", task.Reason, RoleResults)
 264: 			}
 265: 		}
 266: 	})
 267: }
 268: 
 269: // AC-07 â€” multiple H1s: the first becomes the title by structural_rule, a later
 270: // matching H1 is an ordinary node, and a later unmatched H1 is an unresolved
 271: // node rather than a title candidate.
 272: func TestAC07_MultipleH1s(t *testing.T) {
 273: 	md := []byte("# A Study Of Things\n\nAuthors.\n\n" +
 274: 		"# Methodology\n\nMethod prose.\n\n" +
 275: 		"# Zorblatt Considerations\n\nMore prose.\n")
 276: 
 277: 	doc, err := Build(md)
 278: 	if err != nil {
 279: 		t.Fatalf("Build: %v", err)
 280: 	}
 281: 
 282: 	if doc.TitleOrdinal != 0 || doc.TitleMethod != MethodStructuralRule {
 283: 		t.Fatalf("title ordinal = %d, method = %q; want 0 and %q", doc.TitleOrdinal, doc.TitleMethod, MethodStructuralRule)
 284: 	}
 285: 
 286: 	if doc.Nodes[1].Kind != KindSection || doc.Nodes[1].Classification.Role != RoleMethodology {
 287: 		t.Errorf("second H1: kind %q role %q; want section/%s", doc.Nodes[1].Kind, doc.Nodes[1].Classification.Role, RoleMethodology)
 288: 	}
 289: 
 290: 	third := doc.Nodes[2]
 291: 	if third.Kind != KindSection {
 292: 		t.Errorf("third H1 kind = %q, want %q â€” a later H1 is never a title candidate", third.Kind, KindSection)
 293: 	}
 294: 	if third.Classification.Status != StatusUnresolved {
 295: 		t.Errorf("third H1 status = %q, want %q", third.Classification.Status, StatusUnresolved)
 296: 	}
 297: }
 298: 
 299: // AC-08 â€” no H1, or a first H1 resolving to an ordinary role, leaves the title
 300: // unresolved with a title_ambiguity task, while everything else classifies
 301: // normally.
 302: func TestAC08_TitleAmbiguity(t *testing.T) {
 303: 	cases := map[string][]byte{
 304: 		"first H1 resolves to a role": []byte("# Introduction\n\nProse.\n\n## Methodology\n\nMethod prose.\n"),
 305: 		"no H1 at all":                []byte("## Introduction\n\nProse.\n\n## Methodology\n\nMethod prose.\n"),
 306: 	}
 307: 
 308: 	for name, md := range cases {
 309: 		t.Run(name, func(t *testing.T) {
 310: 			doc, err := Build(md)
 311: 			if err != nil {
 312: 				t.Fatalf("Build: %v", err)
 313: 			}
 314: 
 315: 			if doc.TitleStatus != TitleUnresolved {
 316: 				t.Errorf("title status = %q, want %q", doc.TitleStatus, TitleUnresolved)
 317: 			}
 318: 
 319: 			run := NewRun(doc, "ac08", "hash")
 320: 
 321: 			found := false
 322: 			for _, task := range run.Tasks {
 323: 				if task.Reason == ReasonTitleAmbiguity {
 324: 					found = true
 325: 				}
 326: 			}
 327: 			if !found {
 328: 				t.Error("no title_ambiguity task was raised")
 329: 			}
 330: 
 331: 			// Everything else still classifies.
 332: 			last := doc.Nodes[len(doc.Nodes)-1]
 333: 			if last.Classification.Role != RoleMethodology {
 334: 				t.Errorf("last node role = %q, want %q â€” a title problem must not block ordinary classification", last.Classification.Role, RoleMethodology)
 335: 			}
 336: 		})
 337: 	}
 338: }
 339: 
 340: // AC-09 â€” zero silent loss, in both directions. N detected headings produce
 341: // exactly N nodes, and a simulated dropped heading fails the run.
 342: func TestAC09_ZeroSilentLoss(t *testing.T) {
 343: 	md := loadFixture(t)
 344: 
 345: 	doc, err := Build(md)
 346: 	if err != nil {
 347: 		t.Fatalf("Build: %v", err)
 348: 	}
 349: 
 350: 	headings := detectHeadings(md)
 351: 	structural := 0
 352: 	for _, h := range headings {
 353: 		if h.Level >= 1 && h.Level <= 4 {
 354: 			structural++
 355: 		}
 356: 	}
 357: 
 358: 	if len(doc.Nodes) != structural {
 359: 		t.Fatalf("%d detected H1-H4 headings produced %d nodes", structural, len(doc.Nodes))
 360: 	}
 361: 
 362: 	t.Run("a dropped heading fails the run", func(t *testing.T) {
 363: 		damaged := doc
 364: 		damaged.Nodes = doc.Nodes[:len(doc.Nodes)-1]
 365: 
 366: 		err := ValidateNoSilentLoss(damaged, headings)
 367: 		if err == nil {
 368: 			t.Fatal("dropping a node did not violate the invariant")
 369: 		}
 370: 		if !strings.Contains(err.Error(), "silent_loss_invariant") {
 371: 			t.Errorf("error = %q, want it to name silent_loss_invariant", err)
 372: 		}
 373: 	})
 374: }
 375: 
 376: // AC-10 â€” the review overlay, on both axes. A decision supplies the effective
 377: // value; the machine's stored fields are unchanged.
 378: //
 379: // The UNIQUE(review_task_id) half of AC-10 is enforced by the schema and
 380: // belongs to the store's tests, not here.
 381: func TestAC10_ReviewOverlay(t *testing.T) {
 382: 	t.Run("section role", func(t *testing.T) {
 383: 		node := SectionNode{Classification: Classification{Status: StatusUnresolved}}
 384: 		decision := &ReviewDecision{AssignedRole: RoleTheory, AssignedContentClass: ClassAnalytical}
 385: 
 386: 		got := EffectiveFor(node, decision)
 387: 
 388: 		if got.Role != RoleTheory {
 389: 			t.Errorf("effective role = %q, want %q", got.Role, RoleTheory)
 390: 		}
 391: 		if got.Status != EffectiveReviewerConfirmed {
 392: 			t.Errorf("effective status = %q, want %q", got.Status, EffectiveReviewerConfirmed)
 393: 		}
 394: 		if node.Classification.Role != "" || node.Classification.Status != StatusUnresolved {
 395: 			t.Error("the node's machine fields changed; they must remain as provenance")
 396: 		}
 397: 	})
 398: 
 399: 	t.Run("document title", func(t *testing.T) {
 400: 		run := Run{
 401: 			DocumentTitleText:    "",
 402: 			DocumentTitleOrdinal: -1,
 403: 			DocumentTitleStatus:  TitleUnresolved,
 404: 		}
 405: 		decision := &ReviewDecision{
 406: 			AssignedDocumentTitleText:   "The Real Title",
 407: 			AssignedDocumentTitleNodeID: "node-2",
 408: 		}
 409: 
 410: 		got := EffectiveTitleFor(run, decision)
 411: 
 412: 		if got.Text != "The Real Title" || got.NodeID != "node-2" {
 413: 			t.Errorf("effective title = %+v", got)
 414: 		}
 415: 		if got.Status != EffectiveReviewerConfirmed || got.Method != "human" {
 416: 			t.Errorf("effective status/method = %q/%q, want %q/human", got.Status, got.Method, EffectiveReviewerConfirmed)
 417: 		}
 418: 		if run.DocumentTitleStatus != TitleUnresolved {
 419: 			t.Error("the run's stored title status changed")
 420: 		}
 421: 	})
 422: }
 423: 
 424: // AC-14 â€” pre-heading content produces no node, and no node's span reaches back
 425: // into it.
 426: func TestAC14_PreHeadingContentHasNoNode(t *testing.T) {
 427: 	md := loadFixture(t)
 428: 
 429: 	doc, err := Build(md)
 430: 	if err != nil {
 431: 		t.Fatalf("Build: %v", err)
 432: 	}
 433: 
 434: 	headings := detectHeadings(md)
 435: 	firstHeading := headings[0].ByteStart
 436: 
 437: 	if firstHeading == 0 {
 438: 		t.Skip("the fixture has no preamble, so this criterion is not exercised")
 439: 	}
 440: 
 441: 	for _, n := range doc.Nodes {
 442: 		if n.StartOffset < firstHeading {
 443: 			t.Errorf("node %d (%q) starts at %d, before the first heading at %d â€” preamble must belong to no node",
 444: 				n.Ordinal, n.HeadingRaw, n.StartOffset, firstHeading)
 445: 		}
 446: 	}
 447: 
 448: 	// And the preamble text really is absent from every span.
 449: 	preamble := string(md[:firstHeading])
 450: 	if len(strings.TrimSpace(preamble)) == 0 {
 451: 		t.Skip("preamble is whitespace only")
 452: 	}
 453: 	for _, n := range doc.Nodes {
 454: 		if strings.Contains(n.Text(md), strings.TrimSpace(preamble)) {
 455: 			t.Errorf("node %d contains the preamble text", n.Ordinal)
 456: 		}
 457: 	}
 458: }
 459: 
 460: // AC-11 and AC-12 are not implemented here, and AC-13 is implemented elsewhere.
 461: // Each is a claim about something outside this package, and all three are
 462: // carried forward in docs/DEFERRED_CRITERIA.md so the obligation lands on
 463: // whoever builds the step that owns it.
 464: //
 465: // AC-11 (the current-run pointer advances only on Completed) belongs to STEP 2.
 466: // It requires Â§9's pointer chain, and ExtractionRun does not exist in this
 467: // repository. Testing it here would mean creating the column purely so a test
 468: // could read it back. See TODO(step9-pointer) in
 469: // internal/adapters/secondary/approved.
 470: //
 471: // AC-12 (funding never reaches extraction; references and data_availability
 472: // stay available to their consumers) belongs to STEP 4. It is a claim about
 473: // what Step 4 does with the labels. What this package owes it â€” that every
 474: // section carries the correct content_class â€” is established by
 475: // TestAC01_StandardPaper and TestRoleTableMatchesTable.
 476: //
 477: // AC-13 (a hash mismatch fails the run and writes nothing) IS TESTED, in
 478: // internal/adapters/secondary/approved/papers_test.go. The check lives in the
 479: // adapter, so the test lives there too; a package that takes []byte and returns
 480: // nodes cannot reach a database row.
 481: //
 482: // AC-15 (2.2 parent inheritance, with its four limits) IS TESTED, in
 483: // inherit_test.go. It lives in its own file rather than here because four of
 484: // its five clauses are about what inheritance must NOT do, and a rule is only
 485: // worth having if its limits are tested as carefully as its effect.
 486: //
 487: // AC-16 (2.3 child consensus, with its five limits) IS TESTED, in
 488: // consensus_test.go, for the same reason. Seven of its eight tests describe
 489: // cases where the rule must decline to fire.
 490: //
 491: // AC-17 (2.6's title candidate) IS TESTED, in title_test.go. Four of its six
 492: // tests are about where the rule must NOT apply, which is the whole difficulty:
 493: // "the first heading is the title" is true often enough to be dangerous.
 494: //
 495: // AC-18 (2.7's nested-occurrence suppression) IS TESTED, in nested_test.go. Its
 496: // first test is the counter-example that corrected the rule from keywords to
 497: // spans, and it is first on purpose: the version that reasoned about keywords
 498: // passed every other test in that file.
### internal/core/domain/segment/headings.go
   1: package segment
   2: 
   3: import (
   4: 	"github.com/yuin/goldmark/ast"
   5: 	"github.com/yuin/goldmark/parser"
   6: 	"github.com/yuin/goldmark/text"
   7: 	"github.com/yuin/goldmark/util"
   8: )
   9: 
  10: // Heading is one ATX heading found in a markdown document.
  11: //
  12: // Every field is a 0-based BYTE offset into the src buffer passed to
  13: // detectHeadings, never a rune offset and never a UTF-16 code unit. The offsets
  14: // are meaningless against any other buffer; slice the same src that produced
  15: // them.
  16: type Heading struct {
  17: 	// Level is the markdown heading level, 1..6, taken from ast.Heading.Level.
  18: 	// goldmark rejects a run of seven or more '#' outright, so no value outside
  19: 	// that range can reach this field.
  20: 	Level int
  21: 
  22: 	// ByteStart is the offset of the heading's '#' character (D-07).
  23: 	ByteStart int
  24: 
  25: 	// TextStart is the offset at which the heading text begins, with the '#'
  26: 	// markers, the whitespace following them, and any closing '###' sequence
  27: 	// already removed.
  28: 	TextStart int
  29: 
  30: 	// TextStop is exclusive. TextStart == TextStop for an empty heading.
  31: 	TextStop int
  32: 
  33: 	// Inferred marks a heading this package recovered from plain text because
  34: 	// Mathpix did not emit one (Â§3.1, rule version 2.9). goldmark never sets it;
  35: 	// only inferReferencesHeading does.
  36: 	Inferred bool
  37: }
  38: 
  39: // mdParser is the block-only markdown parser this package detects headings
  40: // with. It is built from an EXPLICIT parser set, and the set below is
  41: // exhaustive.
  42: //
  43: // Verified against goldmark v1.8.5 parser/parser.go:462-470, 673-681:
  44: // parser.NewConfig initialises BlockParsers to an empty util.PrioritizedSlice
  45: // and WithBlockParsers APPENDS to it. DefaultBlockParsers is a separate free
  46: // function that NewParser never calls. So a parser built this way contains
  47: // exactly the parsers named here and nothing else.
  48: //
  49: // Three properties of this configuration are decisions, not accidents:
  50: //
  51: //   - NewSetextHeadingParser is deliberately ABSENT. Because the set is
  52: //     exhaustive, omitting it genuinely excludes Setext headings from the
  53: //     grammar. SPLIT-07 is therefore satisfied BY CONSTRUCTION rather than by
  54: //     filtering the output of a parser that ran. With Setext gone and
  55: //     ThematicBreak present, a --- line under a paragraph becomes a thematic
  56: //     break and a === line becomes ordinary paragraph continuation text;
  57: //     neither yields a heading.
  58: //
  59: //   - NewParagraphParser is NOT optional, and omitting it is catastrophic
  60: //     rather than degraded. parseBlocks reads
  61: //     "if p.openBlocks(...) != newBlocksOpened { return }"
  62: //     (parser/parser.go:1085-1087), so with no paragraph parser the first
  63: //     ordinary prose line opens no block, openBlocks returns noBlocksOpened,
  64: //     and parsing STOPS at that line. Every heading after the first paragraph
  65: //     would silently disappear with no error of any kind.
  66: //
  67: //   - NewListParser, NewListItemParser and NewBlockquoteParser are deliberately
  68: //     omitted, and dropping them is strictly SAFER for false headings, not
  69: //     riskier. Without them a blockquoted or list-item heading line becomes a
  70: //     paragraph line whose first byte is '>' or '-', so the ATX trigger (which
  71: //     fires on the first non-space byte) never sees a '#'.
  72: //
  73: // Do NOT generalise that last point into "any parser can be dropped safely".
  74: // Measured on this configuration during plan 01-04: dropping NewCodeBlockParser
  75: // does not merely re-expose an indented '#' as a false heading â€” it makes the
  76: // four-space-indented line open no block at all, which ends parseBlocks early
  77: // and LOSES every heading after it (3 headings become 1 on the fixture in
  78: // TestDetectHeadings_HashInIndentedAndHTMLBlocks). Each of the seven entries
  79: // above earns its place; removing one is a behavioural change, not a cleanup.
  80: //
  81: // No inline parsers, no paragraph transformers, no AST transformers and no
  82: // renderer are configured: this package needs block structure and byte offsets
  83: // only, and never looks inside a heading's inline content.
  84: var mdParser = parser.NewParser(
  85: 	parser.WithBlockParsers(
  86: 		util.Prioritized(parser.NewThematicBreakParser(), 200), // --- is a rule, never an H2
  87: 		util.Prioritized(parser.NewCodeBlockParser(), 500),     // 4-space indented code
  88: 		util.Prioritized(newDisplayMathParser(), 550),          // $$ ... $$ masking (SPLIT-08)
  89: 		util.Prioritized(parser.NewATXHeadingParser(), 600),
  90: 		util.Prioritized(parser.NewFencedCodeBlockParser(), 700),
  91: 		util.Prioritized(parser.NewHTMLBlockParser(), 900),
  92: 		util.Prioritized(parser.NewParagraphParser(), 1000), // MANDATORY, see above
  93: 	),
  94: )
  95: 
  96: // headingTextRange returns the byte range of a heading's text.
  97: //
  98: // The zero-Lines guard is unconditional on purpose. Three distinct return paths
  99: // in atxHeadingParser.Open produce an *ast.Heading carrying ZERO Lines
 100: // segments:
 101: //
 102: //  1. a bare '#' at EOF with no trailing newline;
 103: //  2. "## " followed only by whitespace;
 104: //  3. "### ###", where the whole line is markers.
 105: //
 106: // All three are reachable from OCR output, and on any of them a bare
 107: // h.Lines().At(0) is an index-out-of-range panic. An empty heading is reported
 108: // as the empty range [Pos, Pos), which keeps TextStart == TextStop true exactly
 109: // when the heading has no text.
 110: func headingTextRange(h *ast.Heading) (start, stop int) {
 111: 	if h.Lines().Len() == 0 {
 112: 		p := h.Pos()
 113: 		return p, p
 114: 	}
 115: 	seg := h.Lines().At(0)
 116: 	return seg.Start, seg.Stop
 117: }
 118: 
 119: // detectHeadings returns every ATX heading in src, in document order.
 120: //
 121: // ByteStart is ast.Node.Pos(), which goldmark sets generically at
 122: // parser/parser.go:997 as blockPos.Start + max(pc.BlockOffset(), 0) â€” the
 123: // absolute byte offset of the first non-space byte on the block's opening line.
 124: // For an ATX heading that byte is the '#'. ast.Heading does not override Pos(),
 125: // so it inherits BaseNode.Pos() and that value reaches this function unchanged.
 126: //
 127: // ANTI-PATTERN, stated because it is tempting and wrong: Pos() and
 128: // Lines().At(0) are different things BY DESIGN and neither may be derived from
 129: // the other. Pos() is the '#' byte. Lines().At(0) is the heading TEXT, with the
 130: // markers, the whitespace after them, and any closing '###' sequence already
 131: // stripped and the remainder right-space-trimmed. That trimming is why this is
 132: // strictly better than a regex splitter: a `^(#{1,6})\\s+(.*)$` capture group
 133: // keeps a trailing carriage return on CRLF input, because goldmark's space set
 134: // includes 0x0d but a regex `.` does not.
 135: // A cross-check that back-scans from Lines().At(0).Start is unsafe for the
 136: // three empty-heading cases above; verify Pos() against the raw source bytes
 137: // instead, as assertPosIsHashByte does.
 138: //
 139: // INDENTATION SUBTLETY, worth knowing before Phase 4: CommonMark permits an ATX
 140: // heading to be indented by up to three spaces. For such a heading Pos() points
 141: // at the '#' and NOT at the line start, so under D-08 those leading spaces
 142: // belong to the PRECEDING node. Tiling still holds exactly â€” the preceding
 143: // node ends where this one begins â€” but md[ByteStart:] does not begin at a line
 144: // start for that node.
 145: //
 146: // No sorting happens here and none is needed: goldmark walks the AST in
 147: // document order, so the natural collection order already matches the source.
 148: func detectHeadings(src []byte) []Heading {
 149: 	doc := mdParser.Parse(text.NewReader(src))
 150: 
 151: 	var out []Heading
 152: 	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
 153: 		if !entering {
 154: 			return ast.WalkContinue, nil
 155: 		}
 156: 		h, ok := n.(*ast.Heading)
 157: 		if !ok {
 158: 			return ast.WalkContinue, nil
 159: 		}
 160: 		start, stop := headingTextRange(h)
 161: 		out = append(out, Heading{
 162: 			Level:     h.Level,
 163: 			ByteStart: h.Pos(),
 164: 			TextStart: start,
 165: 			TextStop:  stop,
 166: 		})
 167: 		return ast.WalkContinue, nil
 168: 	})
 169: 
 170: 	return out
 171: }
### internal/platform/security/security.go
   1: // Package security holds the HTTP middleware that hardens epistemicos-api
   2: // for production exposure: CORS, security headers, and a simple
   3: // per-IP token-bucket rate limiter for mutating endpoints.
   4: //
   5: // Intentionally narrow scope â€” auth and TLS termination are deferred
   6: // to the reverse proxy / ingress layer.
   7: package security
   8: 
   9: import (
  10: 	"net"
  11: 	"net/http"
  12: 	"strings"
  13: 	"sync"
  14: 	"time"
  15: )
  16: 
  17: // CORS returns a middleware that adds the standard CORS headers and
  18: // short-circuits OPTIONS preflights. allowedOrigins of "*" enables
  19: // permissive CORS (development); a comma-separated list of origins
  20: // restricts to those.
  21: func CORS(allowedOrigins string) func(http.Handler) http.Handler {
  22: 	parsed := parseOriginList(allowedOrigins)
  23: 	return func(next http.Handler) http.Handler {
  24: 		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
  25: 			origin := r.Header.Get("Origin")
  26: 			if origin != "" && allowed(parsed, origin) {
  27: 				w.Header().Set("Access-Control-Allow-Origin", origin)
  28: 				w.Header().Set("Vary", "Origin")
  29: 				w.Header().Set("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
  30: 				w.Header().Set("Access-Control-Allow-Headers", "Content-Type, X-Correlation-ID")
  31: 				w.Header().Set("Access-Control-Max-Age", "600")
  32: 			}
  33: 			if r.Method == http.MethodOptions {
  34: 				w.WriteHeader(http.StatusNoContent)
  35: 				return
  36: 			}
  37: 			next.ServeHTTP(w, r)
  38: 		})
  39: 	}
  40: }
  41: 
  42: // SecurityHeaders adds a baseline set of security response headers.
  43: // HSTS is only emitted when the request appears to be HTTPS to avoid
  44: // pinning over plain HTTP (which a browser would refuse anyway, but
  45: // also breaks local-dev iteration).
  46: func SecurityHeaders() func(http.Handler) http.Handler {
  47: 	return func(next http.Handler) http.Handler {
  48: 		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
  49: 			h := w.Header()
  50: 			h.Set("X-Content-Type-Options", "nosniff")
  51: 			h.Set("X-Frame-Options", "DENY")
  52: 			h.Set("Referrer-Policy", "no-referrer")
  53: 			h.Set("Permissions-Policy", "interest-cohort=()")
  54: 			if isHTTPS(r) {
  55: 				h.Set("Strict-Transport-Security", "max-age=31536000; includeSubDomains")
  56: 			}
  57: 			next.ServeHTTP(w, r)
  58: 		})
  59: 	}
  60: }
  61: 
  62: // RateLimitConfig configures the token-bucket limiter. Refill rate and
  63: // burst are per-IP; the limiter only applies to method paths whose
  64: // matcher returns true (typically POST endpoints).
  65: type RateLimitConfig struct {
  66: 	RequestsPerMinute int                      // sustained per-IP rate
  67: 	Burst             int                      // bucket capacity
  68: 	Match             func(*http.Request) bool // returns true if rate limit applies
  69: }
  70: 
  71: // RateLimit returns middleware enforcing a per-IP token bucket on
  72: // requests that match cfg.Match. Buckets are stored in memory and
  73: // expire after 10 minutes of inactivity (a janitor goroutine sweeps).
  74: func RateLimit(cfg RateLimitConfig) func(http.Handler) http.Handler {
  75: 	if cfg.RequestsPerMinute <= 0 {
  76: 		cfg.RequestsPerMinute = 60
  77: 	}
  78: 	if cfg.Burst <= 0 {
  79: 		cfg.Burst = 10
  80: 	}
  81: 	rl := &rateLimiter{
  82: 		fillEvery: time.Minute / time.Duration(cfg.RequestsPerMinute),
  83: 		burst:     cfg.Burst,
  84: 		buckets:   make(map[string]*bucket),
  85: 		now:       time.Now,
  86: 	}
  87: 	go rl.sweep()
  88: 	return func(next http.Handler) http.Handler {
  89: 		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
  90: 			if cfg.Match != nil && !cfg.Match(r) {
  91: 				next.ServeHTTP(w, r)
  92: 				return
  93: 			}
  94: 			if !rl.allow(clientIP(r)) {
  95: 				w.Header().Set("Retry-After", "60")
  96: 				http.Error(w, "rate limit exceeded", http.StatusTooManyRequests)
  97: 				return
  98: 			}
  99: 			next.ServeHTTP(w, r)
 100: 		})
 101: 	}
 102: }
 103: 
 104: // MutatingRequestMatcher returns true for HTTP methods that mutate
 105: // state â€” the natural target for rate limiting. Convenience helper
 106: // callers pass as RateLimitConfig.Match.
 107: func MutatingRequestMatcher(r *http.Request) bool {
 108: 	switch r.Method {
 109: 	case http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodDelete:
 110: 		return true
 111: 	default:
 112: 		return false
 113: 	}
 114: }
 115: 
 116: // --- helpers ---
 117: 
 118: func parseOriginList(s string) []string {
 119: 	if strings.TrimSpace(s) == "" {
 120: 		return nil
 121: 	}
 122: 	parts := strings.Split(s, ",")
 123: 	out := make([]string, 0, len(parts))
 124: 	for _, p := range parts {
 125: 		p = strings.TrimSpace(p)
 126: 		if p != "" {
 127: 			out = append(out, p)
 128: 		}
 129: 	}
 130: 	return out
 131: }
 132: 
 133: func allowed(list []string, origin string) bool {
 134: 	for _, o := range list {
 135: 		if o == "*" || o == origin {
 136: 			return true
 137: 		}
 138: 	}
 139: 	return false
 140: }
 141: 
 142: func isHTTPS(r *http.Request) bool {
 143: 	if r.TLS != nil {
 144: 		return true
 145: 	}
 146: 	// Honour X-Forwarded-Proto when behind a TLS-terminating proxy.
 147: 	return strings.EqualFold(r.Header.Get("X-Forwarded-Proto"), "https")
 148: }
 149: 
 150: // clientIP extracts the client IP from X-Forwarded-For (first hop) or
 151: // falls back to RemoteAddr. Used as the rate-limit bucket key.
 152: func clientIP(r *http.Request) string {
 153: 	if xf := r.Header.Get("X-Forwarded-For"); xf != "" {
 154: 		// "client, proxy1, proxy2" â€” take the leftmost.
 155: 		if comma := strings.IndexByte(xf, ','); comma >= 0 {
 156: 			return strings.TrimSpace(xf[:comma])
 157: 		}
 158: 		return strings.TrimSpace(xf)
 159: 	}
 160: 	host, _, err := net.SplitHostPort(r.RemoteAddr)
 161: 	if err != nil {
 162: 		return r.RemoteAddr
 163: 	}
 164: 	return host
 165: }
 166: 
 167: type bucket struct {
 168: 	tokens    float64
 169: 	updatedAt time.Time
 170: }
 171: 
 172: type rateLimiter struct {
 173: 	mu        sync.Mutex
 174: 	buckets   map[string]*bucket
 175: 	fillEvery time.Duration
 176: 	burst     int
 177: 	now       func() time.Time
 178: }
 179: 
 180: // allow consumes one token from the IP's bucket. Returns true if the
 181: // caller may proceed, false if the bucket is empty.
 182: func (rl *rateLimiter) allow(ip string) bool {
 183: 	rl.mu.Lock()
 184: 	defer rl.mu.Unlock()
 185: 	now := rl.now()
 186: 	b, ok := rl.buckets[ip]
 187: 	if !ok {
 188: 		b = &bucket{tokens: float64(rl.burst), updatedAt: now}
 189: 		rl.buckets[ip] = b
 190: 	}
 191: 	// Refill since last access.
 192: 	elapsed := now.Sub(b.updatedAt)
 193: 	b.tokens += float64(elapsed) / float64(rl.fillEvery)
 194: 	if b.tokens > float64(rl.burst) {
 195: 		b.tokens = float64(rl.burst)
 196: 	}
 197: 	b.updatedAt = now
 198: 	if b.tokens < 1.0 {
 199: 		return false
 200: 	}
 201: 	b.tokens -= 1.0
 202: 	return true
 203: }
 204: 
 205: // sweep periodically drops idle bucket entries to bound memory.
 206: func (rl *rateLimiter) sweep() {
 207: 	ticker := time.NewTicker(2 * time.Minute)
 208: 	defer ticker.Stop()
 209: 	for now := range ticker.C {
 210: 		rl.mu.Lock()
 211: 		for ip, b := range rl.buckets {
 212: 			if now.Sub(b.updatedAt) > 10*time.Minute {
 213: 				delete(rl.buckets, ip)
 214: 			}
 215: 		}
 216: 		rl.mu.Unlock()
 217: 	}
 218: }
