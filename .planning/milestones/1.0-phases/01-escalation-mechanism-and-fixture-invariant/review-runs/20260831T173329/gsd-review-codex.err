 145: //
 146: // No sorting happens here and none is needed: goldmark walks the AST in
 147: // document order, so the natural collection order already matches the source.
 148: func detectHeadings(src []byte) []Heading {
 149: 	doc := mdParser.Parse(text.NewReader(src))
 150: 
 151: 	var out []Heading
 152: 	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
 153: 		if !entering {
 154: 			return ast.WalkContinue, nil
 155: 		}
 156: 		h, ok := n.(*ast.Heading)
 157: 		if !ok {
 158: 			return ast.WalkContinue, nil
 159: 		}
 160: 		start, stop := headingTextRange(h)
 161: 		out = append(out, Heading{
 162: 			Level:     h.Level,
 163: 			ByteStart: h.Pos(),
 164: 			TextStart: start,
 165: 			TextStop:  stop,
 166: 		})
 167: 		return ast.WalkContinue, nil
 168: 	})
 169: 
 170: 	return out
 171: }
