### .github/workflows/ci.yml
   1: name: ci
   2: 
   3: on:
   4:   push:
   5:     branches: [main]
   6:   pull_request:
   7:     branches: [main]
   8: 
   9: jobs:
  10:   go:
  11:     name: vet + test + fmt
  12:     runs-on: ubuntu-latest
  13: 
  14:     # The 38 store and approved tests connect to a real Postgres. Without this
  15:     # service they skip, and `go test` reports ok for a suite that tested
  16:     # nothing. Image and credentials match docker-compose.yml so a failure here
  17:     # reproduces locally with `make up`.
  18:     services:
  19:       postgres:
  20:         image: postgres:16-alpine
  21:         env:
  22:           POSTGRES_DB: epistemicos
  23:           POSTGRES_USER: epistemicos
  24:           POSTGRES_PASSWORD: epistemicos
  25:         ports:
  26:           - 5432:5432
  27:         options: >-
  28:           --health-cmd "pg_isready -U epistemicos -d epistemicos"
  29:           --health-interval 5s
  30:           --health-timeout 5s
  31:           --health-retries 5
  32: 
  33:     env:
  34:       # Host is localhost, not the service name: this job runs directly on the
  35:       # runner, so the service reaches it through the mapped port.
  36:       EPISTEMIC_OS_DB_URL: postgres://epistemicos:epistemicos@localhost:5432/epistemicos?sslmode=disable
  37: 
  38:     steps:
  39:       - uses: actions/checkout@v4
  40: 
  41:       - uses: actions/setup-go@v5
  42:         with:
  43:           go-version: "1.24"
  44:           cache: true
  45: 
  46:       - name: go vet
  47:         run: go vet ./...
  48: 
  49:       # gofmt is a gate here, unlike in the predecessor repository where it
  50:       # was never enforced and 25 files had accumulated drift. Starting clean
  51:       # means it can stay clean.
  52:       - name: gofmt
  53:         run: |
  54:           unformatted=$(gofmt -l .)
  55:           if [ -n "$unformatted" ]; then
  56:             echo "unformatted files:"
  57:             echo "$unformatted"
  58:             exit 1
  59:           fi
  60: 
  61:       - name: go build
  62:         run: go build ./...
  63: 
  64:       # The store tests assume the schema already exists; they do not apply
  65:       # migrations themselves. A missing table surfaces as a query error rather
  66:       # than a skip, so this step failing is loud, not silent.
  67:       - name: migrate
  68:         run: go run ./cmd/epistemicos-cli migrate up
  69: 
  70:       - name: go test
  71:         run: go test ./... -count=1
  72: 
  73:   docker:
  74:     name: docker build smoke
  75:     runs-on: ubuntu-latest
  76:     steps:
  77:       - uses: actions/checkout@v4
  78:       - name: build api image
  79:         run: docker build -f deploy/Dockerfile.api -t epistemicos-api:ci .
