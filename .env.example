# EpistemicOS — environment configuration
#
# Copy to .env and fill in. The API binary loads .env automatically via
# godotenv; the CLI does the same.
#
# The prefix is EPISTEMIC_OS_. It was PAPERLY_ until 24 August 2026, inherited
# from a predecessor deployment that no longer exists. If you have an older .env,
# rename the variables; the loader will tell you so by name rather than just
# reporting the new one missing.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string. The API refuses to start without it.
EPISTEMIC_OS_DB_URL=postgres://epistemicos:epistemicos@localhost:5432/epistemicos?sslmode=disable

# ---------------------------------------------------------------------------
# Mathpix — PDF to markdown
# ---------------------------------------------------------------------------
#
# Without these the service still starts and serves reads, but ingest fails at
# the conversion step and GET /api/v1/capabilities reports
# mathpix_enabled=false.

MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ---------------------------------------------------------------------------
# Anthropic — OPTIONAL, and used by nothing in the pipeline
# ---------------------------------------------------------------------------
#
# Only `epistemicos-cli suggest` reads this. That command asks an LLM which role
# an unresolved section should have and PRINTS the answers; it writes nothing.
#
# Specification §13 defers every LLM mechanism from the MVP. Segmentation is and
# stays deterministic: the same markdown yields the same sections and the same
# open questions whether or not this key is set, and whether or not the network
# is reachable. Leave it empty and everything except `suggest` works exactly as
# before.

ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# API bind address.
EPISTEMIC_OS_LISTEN_ADDR=:9082

# Where downloaded PDFs are staged before conversion.
EPISTEMIC_OS_PDF_VOLUME=./data/pdfs

# Comma-separated origins, or "*". Set to the real client origin in production.
EPISTEMIC_OS_CORS_ALLOWED_ORIGINS=*

# Per-IP rate limit on mutating endpoints. 0 disables the limiter.
EPISTEMIC_OS_RATE_LIMIT_RPM=60
EPISTEMIC_OS_RATE_LIMIT_BURST=20
